# MoneyApp Telegram — шаблон конфига.
# Скопируй в .env и заполни:  cp .env.example .env
# .env НЕ коммитится в репозиторий (см. .gitignore).

# Токен бота: @BotFather -> /newbot -> скопировать токен.
# Токен — секрет: только в локальный .env, не в репо и не в чатах.
# Используется для всех вызовов Telegram API и для HMAC-проверки
# WebApp initData (авторизация пользователей мини-аппа).
BOT_TOKEN=123456:ABC-your-bot-token

# Публичный HTTPS-адрес мини-аппа (должен быть доступен из интернета).
# Приложение автоматически вешает этот URL на кнопку меню бота каждому пользователю.
WEBAPP_URL=https://your-domain/

# Локальный адрес прослушивания (за reverse-прокси).
LISTEN=127.0.0.1:8100
